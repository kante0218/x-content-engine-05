# Account: @ikemen_consult (イケメンコンサル / 男性向けセルフアップ・アフィリエイト運用)
# このファイルをコピーして .env を作成し、各値を埋める: cp .env.example .env
# X Developer App: https://developer.x.com → Projects & Apps → Keys and tokens
#   App permissions は必ず "Read and Write" にする(投稿に必要)

# --- OAuth 1.0a User Context (投稿) ---
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- 運用対象アカウント ---
X_HANDLE=ikemen_consult
X_USER_ID=

# --- 文字数上限(本文は230前後に抑える) ---
X_MAX_CHARS=230
# 1日あたりのアフィリエイト投稿上限
X_AFFILIATE_MAX_PER_DAY=1

# --- Claude API (生成・推敲用) ---
ANTHROPIC_API_KEY=

# 既定: false=ドラフト推敲のみで実投稿しない、true=推敲後にX本番投稿
X_LIVE_POST=false
